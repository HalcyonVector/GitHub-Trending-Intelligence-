# ── Backend ────────────────────────────────────────────────────────────────────
# PostgreSQL (Supabase connection string)
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# Redis (Upstash)
REDIS_URL=redis://:[YOUR-TOKEN]@[ENDPOINT].upstash.io:6379

# GitHub Personal Access Token (classic, read:repo scope)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# ── AI insight provider ──────────────────────────────────────────────────────
# ollama (free, local) | groq / openai (free/paid, OpenAI-compatible) | anthropic (paid) | off
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

# Anthropic Claude API (only needed if AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Web Push (VAPID) — free browser push. Generate a keypair with:
#   cd backend && python scripts/generate_vapid.py
# Paste the two values below. Leave blank to disable push (app still works).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Notifications & weekly digest (all optional; unset channels are skipped) ──
# Discord / Slack incoming webhooks:
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
# Email via Resend (https://resend.com, free tier). ALERT_EMAIL_TO takes one address
# or a comma-separated list of subscribers. To reach addresses other than your Resend
# signup email, verify a domain and set ALERT_EMAIL_FROM to an address on it.
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=GTI <onboarding@resend.dev>

# ── Frontend ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://your-backend.railway.app

# ── Optional overrides ─────────────────────────────────────────────────────────
DEBUG=false
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
AI_MAX_TOKENS=1024
AI_DAILY_BUDGET_USD=5.0
CACHE_TTL_DASHBOARD=300
